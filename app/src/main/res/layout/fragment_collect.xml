<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/collect_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

        <AutoCompleteTextView
            android:id="@+id/farmerPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/pick_farmer"
            android:inputType="text" />

        <EditText
            android:id="@+id/collectDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/collect_date"
            android:inputType="date" />

        <Spinner
            android:id="@+id/shiftSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/shift_options" />

        <EditText
            android:id="@+id/litresInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/litres"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/fatInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fat"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/snfInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/snf"
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/ratePreviewText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rate_preview_default" />

        <Button
            android:id="@+id/saveCollectionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/save_collection" />

        <Button
            android:id="@+id/rateChartButton"
            style="?attr/materialButtonOutlinedButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rate_chart_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/today_collections"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

        <TextView
            android:id="@+id/todaySummaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/todayList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/todayEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_collections_today" />
    </LinearLayout>
</ScrollView>
