<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/farmerNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/farmer_name"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/farmerVillageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/village"
        android:inputType="text" />

    <EditText
        android:id="@+id/farmerPhoneInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/phone"
        android:inputType="phone" />

    <EditText
        android:id="@+id/farmerBankInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/bank_account"
        android:inputType="text" />

    <EditText
        android:id="@+id/farmerIfscInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ifsc"
        android:inputType="textCapCharacters" />
</LinearLayout>
