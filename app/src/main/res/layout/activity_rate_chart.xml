<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rate_chart_help" />

    <EditText
        android:id="@+id/dairyNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/dairy_name"
        android:inputType="text" />

    <EditText
        android:id="@+id/defaultRateInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/default_rate"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/saveSettingsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/save_settings" />

    <Button
        android:id="@+id/addSlabButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/add_slab" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/slabList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/slabEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_slabs" />
</LinearLayout>
