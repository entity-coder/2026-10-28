<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sheets_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

    <EditText
        android:id="@+id/periodStartInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/period_start"
        android:inputType="date" />

    <EditText
        android:id="@+id/periodEndInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/period_end"
        android:inputType="date" />

    <Button
        android:id="@+id/loadSheetButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/load_sheet" />

    <TextView
        android:id="@+id/sheetTotalsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheetList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/sheetEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sheet_empty" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/shareSheetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share_sheet" />

        <Button
            android:id="@+id/printSheetButton"
            style="?attr/materialButtonOutlinedButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/print_sheet" />
    </LinearLayout>
</LinearLayout>
